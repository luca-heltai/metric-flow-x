# Assembly benchmark on the complete coupled arterial-venous 1D topology.
subsection Metric Flow Parameters
  set Density (rho) = 1040
  set Profile constant for friction term (xi) = 2
  set Viscosity coefficient (mu) = 0.004
end
subsection Functions
  set Inflow function = 96.36e-6
end
subsection MetricFlowSystem<1, 3>
  set Vtk file path for mesh input = @DATA_DIR@/adavn_full.vtk
  set Wall model = ADAVN mixed
  set Terminal connections CSV file = @DATA_DIR@/connections.csv
  set Viscoelastic wall = false
  set Finite element degree = 2
  set Number of global refinement = 0
  set Number of refinement cycles = 1
  set Numerical flux type = HLL_HDG
  set Outlet boundary condition type = RCR
  set Use direct solver = true
  set Output directory = @DATA_DIR@/hdg_output
  set Verbosity (console depth) = 0
end
