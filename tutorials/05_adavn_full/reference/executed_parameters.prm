# Open-loop full arterial-venous model. Read README.md for the explicit
# reductions relative to the closed-loop physiological model of Müller 2023.
subsection Metric Flow Parameters
  set Density (rho) = 1040
  set Profile constant for friction term (xi) = 2
  set Viscosity coefficient (mu) = 0.004
end
subsection Functions
  # Smooth nonnegative prescribed pulse, period 0.8 s and exact mean 96.36 ml/s.
  # Mean((1+cos)^8) = binomial(16,8)/2^8 = 50.2734375.
  # This is an analytic forcing, not the paper's closed-loop heart model.
  set Inflow function = 96.36e-6*(1-0.8*cos(2*3.141592653589793*t/0.8))
end
subsection MetricFlowSystem<1, 3>
  set Run mode = transient
  set Vtk file path for mesh input = /data/home/lheltai/codes/metric-flow-x-adan-full/build/adavn_beds/adavn_full.vtk
  set Terminal connections CSV file = /data/home/lheltai/codes/metric-flow-x-adan-full/build/adavn_beds/connections.csv
  set Wall model = ADAVN mixed
  set Viscoelastic wall = false
  set Initial state source = steady network
  set Initial condition policy = native
  set Finite element degree = 2
  set Number of global refinement = 0
  set Number of refinement cycles = 1
  set Numerical flux type = HLL_HDG
  set Outlet boundary condition type = RCR
  set Theta (penalty parameter) = 0.5
  set Theta Boundary (stability parameter) = 0.5
  set Use direct solver = true
  set Maximum IDA internal steps per output = 10000
  set Use componentwise absolute tolerances = true
  set Area absolute tolerance fraction = 1e-6
  set Velocity absolute tolerance = 1e-6
  set Capacitor pressure absolute tolerance = 0.01
  set Output directory = /data/home/lheltai/codes/metric-flow-x-adan-full/build/adavn_beds/transient_p2
  set Output filename = adavn_full
  # Aortic source row 815 and the three central venous drainage rows.
  # Each source row has two cells with distinct material IDs.
  set Vessel probe IDs = 1630, 1631, 8298, 8299, 8574, 8575, 8696, 8697
  set Output vessel CSV file = probes.csv
  set Output terminal CSV file = terminals.csv
  set Output time interval = 0.02
  set Tolerance ramp enabled = true
  set Tolerance ramp initial relative factor = 100
  set Tolerance ramp initial absolute factor = 100
  # Three very loose cycles, then geometric tightening to the end of cycle six.
  set Tolerance ramp hold duration = 2.4
  set Tolerance ramp end time = 4.8
  set Print current statistics = true
  set Verbosity (console depth) = 0
  subsection IDA parameters
    set Initial time = 0
    set Final time = 8
    set Time interval between each output = 0.02
    subsection Error control
      set Absolute error tolerance = 1e-7
      set Relative error tolerance = 1e-5
    end
    subsection Running parameters
      set Initial step size = 1e-4
      set Maximum step size = 0.02
      set Minimum step size = 1e-12
      set Maximum number of nonlinear iterations = 20
      set Nonlinear convergence coefficient = 1e-4
      set Maximum order of BDF = 2
    end
  end
end
