# WP-07 evidence template; not a claimed runnable MMS case.
subsection MetricFlowSystem<1, 3>
  # Startup policy from the full ADAVN tutorial; see doc/transient_parameters.md.
  # Preserve scalar tolerances throughout verification/MMS trajectories.
  set Run mode = transient
  set Initial state source = rest
  set Initial condition policy = native
  set Maximum IDA internal steps per output = 10000
  set Use componentwise absolute tolerances = false
  set Tolerance ramp enabled = false
  set Print current statistics = true
  set Finite element degree                = 2
  set Number of global refinement          = 2
  set Number of refinement cycles          = 5
  set Numerical flux type                  = HLL
  set Outlet boundary condition type       = RCR
  set Output directory                     = output/p2
  set Use direct solver                    = true
  set Verbosity (console depth)            = 1
  set Vtk file path for mesh input         = @SOURCE_DIR@/parameters/single_vessel.vtk
  subsection IDA parameters
    set Final time                        = 0.1
    set Initial time                      = 0
    set Time interval between each output = 0.1
    subsection Error control
      set Absolute error tolerance = 1e-10
      set Relative error tolerance = 1e-10
    end
    subsection Running parameters
      set Maximum step size = 0.02
      set Initial step size          = 1e-3
      set Maximum order of BDF       = 2
      set Minimum step size          = 1e-12
    end
  end
end
subsection Functions
  set Exact solution    = t*sin(2*PI*x) + 4; cos(2*PI*x)/(2*PI*(t*sin(2*PI*x) + 4))
  # Legacy initial condition (not registered) = 4; cos(2*PI*x)/(2*PI*4)
  # Replace only after the source-derived expression has been wired to vessel constants.
  set RHS expression   = 0.0; 0.0
end
