@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(deal.II 9.5.0)
include("${CMAKE_CURRENT_LIST_DIR}/MetricFlowXTargets.cmake")

# Exported concrete targets were built together in a single-config tree.
# Present their artifacts as real Debug/Release configurations of one target.
if(NOT TARGET MetricFlowX::metric_flow_x)
  add_library(MetricFlowX::metric_flow_x SHARED IMPORTED)
  foreach(_variant IN ITEMS @METRIC_FLOW_X_BUILD_TYPES@)
    string(TOUPPER "${_variant}" _variant_upper)
    set(_concrete MetricFlowX::metric_flow_x_${_variant})
    get_target_property(_configs ${_concrete} IMPORTED_CONFIGURATIONS)
    list(GET _configs 0 _config)
    set_property(TARGET MetricFlowX::metric_flow_x APPEND PROPERTY
      IMPORTED_CONFIGURATIONS ${_variant_upper})
    foreach(_property IN ITEMS LOCATION SONAME IMPLIB)
      get_target_property(_value ${_concrete} IMPORTED_${_property}_${_config})
      if(_value)
        set_property(TARGET MetricFlowX::metric_flow_x PROPERTY
          IMPORTED_${_property}_${_variant_upper} "${_value}")
      endif()
    endforeach()
    get_target_property(_includes ${_concrete} INTERFACE_INCLUDE_DIRECTORIES)
    set_property(TARGET MetricFlowX::metric_flow_x PROPERTY
      INTERFACE_INCLUDE_DIRECTORIES "${_includes}")
    get_target_property(_links ${_concrete} INTERFACE_LINK_LIBRARIES)
    if("@CMAKE_BUILD_TYPE@" STREQUAL "DebugRelease")
      if(_variant STREQUAL "Debug")
        set(_condition "$<CONFIG:Debug>")
      else()
        set(_condition "$<NOT:$<CONFIG:Debug>>")
      endif()
      set_property(TARGET MetricFlowX::metric_flow_x APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES "$<${_condition}:${_links}>")
    else()
      set_property(TARGET MetricFlowX::metric_flow_x PROPERTY
        INTERFACE_LINK_LIBRARIES "${_links}")
    endif()
  endforeach()
endif()
check_required_components(MetricFlowX)
