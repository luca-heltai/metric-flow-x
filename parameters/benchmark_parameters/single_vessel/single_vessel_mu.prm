# Historical case migrated to the IDA parameter schema.
# Vessel constants/initial data still require a physical migration; see
# doc/transient_parameters.md. This file does not certify an MMS solution.
subsection MetricFlowSystem<1, 3>
  # Startup policy from the full ADAVN tutorial; see doc/transient_parameters.md.
  # Preserve scalar tolerances throughout verification/MMS trajectories.
  set Run mode = transient
  set Initial state source = rest
  set Initial condition policy = native
  set Maximum IDA internal steps per output = 10000
  set Use componentwise absolute tolerances = false
  set Tolerance ramp enabled = false
  set Print current statistics = true
  set Finite element degree                = 2
  set Number of global refinement          = 8
  set Number of refinement cycles          = 1
  set Numerical flux type                  = HLL
  set Outlet boundary condition type       = Rt
  set Output filename                      = solution
  set Problem constants                    = 1.0
  set Theta Boundary (stability parameter) = 0.5
  set Theta (penalty parameter)            = 0.5
  set Use Riemann Invariants               = true
  set Use direct solver                    = true
  set Verbosity (console depth)            = 1
  subsection IDA parameters
    set Final time                        = 1.5
    set Initial time                      = 0
    set Time interval between each output = 0.01
    subsection Error control
      set Absolute error tolerance = 1e-06
      set Relative error tolerance = 1e-05
    end
    subsection Running parameters
      set Maximum step size = 0.01
      set Initial step size                      = 1e-3
      set Maximum number of nonlinear iterations = 10
      set Maximum order of BDF                   = 5
      set Minimum step size                      = 1e-12
    end
  end
end
subsection Metric Flow Parameters
  # Legacy value: Capacitance of terminal capacitor (C)           = 5.0e-10
  set Density (rho)                                   = 1050.0
  # Legacy value: Diastolic pressure (p_d)                        = 0
  # Legacy value: Elastic modulus of the vessel wall (E)          = 4e5
  # Legacy value: Length of the vessel (L)                        = 10.0
  # Legacy value: Pressure at terminal boundary (P_out)           = 0
  # Legacy value: Reference cross-sectional area (a0)             = 3.14e-4
  # Legacy value: Area at diastolic pressure (a_d)                = 3.14e-4
  # Legacy value: Reference pressure (p0)                         = 0
  # Legacy value: Reference radius (r0)                           = 0.0100
  set Reflection coefficient at outflow boundary (Rt) = 0.0
  # Legacy value: Resistance of distal capacitor (R2)             = 1.1e9
  # Legacy value: Resistance of proximal capacitor (R1)           = 1.2e8
  set Tube law exponent (m)                           = 0.5
  set Viscosity coefficient (mu)                      = 0.004
  set Profile constant for friction term (xi)         = 9.0
  # Legacy value: Wall thickness (h_wall)                         = 0.0015
end
subsection Functions
  set Exact solution    = 1e-4; 0.0
  set Inflow function   = 1e-6 * exp(-10000*(t-0.05)^2)
  # Legacy value: Initial condition = a0; 0.0
  set RHS expression    = 0.0; 0.0
end
