# Portable effective-physics template; benchmark_initialization.py resolves mesh paths using --source.
# Large datasets: scripts/download_datasets.sh (see doc/reproducibility.md).
subsection MetricFlowSystem<1, 3>
  # Startup policy from the full ADAVN tutorial; see doc/transient_parameters.md.
  set Run mode = transient
  set Initial state source = steady network
  set Initial condition policy = native
  set Maximum IDA internal steps per output = 10000
  set Use componentwise absolute tolerances = true
  set Tolerance ramp enabled = true
  set Print current statistics = true
  set Area absolute tolerance fraction = 1e-6
  set Velocity absolute tolerance = 1e-6
  set Capacitor pressure absolute tolerance = 0.01
  set Tolerance ramp initial relative factor = 100
  set Tolerance ramp initial absolute factor = 100
  set Tolerance ramp hold duration = 0.0005
  set Tolerance ramp end time = 0.001
  set Finite element degree                = 1
  set Number of global refinement          = 0
  set Number of refinement cycles          = 1
  set Vtk file path for mesh input         = notebooks/networks_by_svv/trees/network_10000_adnr.vtk
  set Numerical flux type                  = HLL
  set Outlet boundary condition type       = RCR
  set Output directory                     = output
  set Output filename                      = solution
  set Problem constants                    = 1.0
  set Theta Boundary (stability parameter) = 1
  set Theta (penalty parameter)            = 1
  set Gamma (Total pressure factor)        = 0.0
  set Use Riemann Invariants               = true
  set Use direct solver                    = true
  set Use junction mesh                    = true
  set Verbosity (console depth)            = 0
  subsection IDA parameters
    set Final time                        = .002
    set Initial time                      = 0
    set Time interval between each output = 0.001
    subsection Error control
      set Absolute error tolerance = 1e-05
      set Relative error tolerance = 1e-06
    end
    subsection Running parameters
      set Maximum step size = 0.02
      set Nonlinear convergence coefficient = 1e-4
      set Initial step size                      = 1e-04
      set Maximum number of nonlinear iterations = 20
      set Maximum order of BDF                   = 1
      set Minimum step size                      = 1e-12
    end
  end
end
subsection Metric Flow Parameters
  set Density (rho)                                   = 1060
  set Profile constant for friction term (xi)         = 2
  set Reflection coefficient at outflow boundary (Rt) = 0.5
  set Tube law exponent (m)                           = 0.5
  set Viscosity coefficient (mu)                      = 0.001
end
subsection Functions
set Inflow function = (1 - exp(-t/0.01))*(8.178e-07+1.799e-07*sin(2*3.1415926*t/1.000000+0.300000)+5.725e-08*sin(4*3.1415926*t/1.000000-0.900000)+2.453e-08*sin(6*3.1415926*t/1.000000+1.200000))
end
